{
  "name": "duet-app",
  "version": "0.1.0",
  "private": true,
  "description": "Formal TypeScript Electron walking skeleton for Duet.",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run clean && npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron dist/main/main.js",
    "dev": "npm run start",
    "e2e:gui-walking-skeleton": "npm run build && node tests/e2e/gui-walking-skeleton.mjs",
    "e2e:task-tabs": "npm run build && node tests/e2e/task-tabs.mjs",
    "e2e:preview-dirty": "npm run build && node tests/e2e/preview-dirty.mjs",
    "e2e:floating-window-lifecycle": "npm run build && node tests/e2e/floating-window-lifecycle.mjs",
    "e2e:run-chat-transcript": "npm run build && node tests/e2e/run-chat-transcript.mjs",
    "e2e:task-entry": "npm run build && node tests/e2e/task-entry.mjs",
    "e2e:approval-surface": "npm run build && node tests/e2e/approval-surface.mjs",
    "e2e:artifact-review-actions": "npm run build && node tests/e2e/artifact-review-actions.mjs",
    "e2e:inspector-review-linkage": "npm run build && node tests/e2e/inspector-review-linkage.mjs",
    "e2e:inspector-folder-external": "npm run build && node tests/e2e/inspector-folder-external.mjs",
    "e2e:stop-continue": "npm run build && node tests/e2e/stop-continue.mjs",
    "e2e:open-task": "npm run build && node tests/e2e/open-task.mjs",
    "smoke:runtime-modules": "npm run build && ELECTRON_RUN_AS_NODE=1 electron tests/smoke/runtime-modules.mjs",
    "smoke:codex-terminalhost": "npm run build && ELECTRON_RUN_AS_NODE=1 electron tests/smoke/codex-terminalhost.mjs",
    "smoke:command-approval": "npm run build && ELECTRON_RUN_AS_NODE=1 electron tests/smoke/command-approval.mjs",
    "rebuild:electron": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^24.0.0",
    "electron": "^42.1.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
