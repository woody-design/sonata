.DS_Store

# Dependencies / build output
node_modules/
dist/
build/
# electron-builder packaged output (app/electron-builder.yml → directories.output)
release/
coverage/
__pycache__/
*.pyc

# Local scratch space (screenshots, one-off references)
Temp/

# Per-workspace runtime artifacts (statusline/hook sinks, usage) — never source.
# .duet/ kept: pre-rename dirs may linger on disk in either worktree.
.sonata/
.duet/

# Local env / logs
.env
.env.*
!.env.example
*.log

# Process layer stays private (D6/D7) — human↔AI collaboration mechanics never
# reach the public code repo. `git add -A` must be unable to publish any of it.
#   private/    — living private docs (D7); its own git repo with a private remote
#   /CLAUDE.md  — untracked session guardrails (repo-root only; app/ may have none)
#   .claude/    — Claude Code discovery dir (skills, settings) — untracked
private/
/CLAUDE.md
.claude/

# Spikes are process-private BY DEFAULT (D6) — throwaway probes are engineering
# scratch, not shippable source, and may carry captured personal paths/payloads.
# History: 60f957f committed the multi-image-paste-probe through a gitignore gap;
# Woody sanctioned THAT one public, so it stays tracked (gitignore never untracks
# already-tracked files — `git ls-files spikes/` still lists it). On 2026-07-23
# the default flipped back to private: new spikes are ignored, and any spike worth
# publishing is promoted deliberately, per-file, with `git add -f`.
spikes/

# electron-builder packaging residue: a trimmed copy of app/package.json (deps
# only, no scripts) appears at the repo root on each release build. Derived,
# read by nothing, regenerated per release — never commit it (ruled 2026-07-26,
# OBS D6).
/package.json
