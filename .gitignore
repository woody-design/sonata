.DS_Store

# Dependencies / build output
node_modules/
dist/
build/
# electron-builder packaged output (app/electron-builder.yml → directories.output)
release/
coverage/
__pycache__/
*.pyc

# Local scratch space (screenshots, one-off references)
Temp/

# Design-system verification screenshot matrix (S6 acceptance material — uncommitted)
design/verify-2026-07-15/

# Per-workspace runtime artifacts (statusline/hook sinks, usage) — never source.
# .duet/ kept: pre-rename dirs may linger on disk in either worktree.
.sonata/
.duet/

# Local env / logs
.env
.env.*
!.env.example
*.log

# Provider/runtime diagnostic captures should be opt-in artifacts, not default source.
spikes/**/control-workspace/**
!spikes/**/control-workspace/
!spikes/**/control-workspace/README.md
spikes/**/sample-output/last-run.*
spikes/**/sample-output/latest-*-summary.json
spikes/**/sample-output/*.raw.jsonl
spikes/**/sample-output/*.raw.txt
spikes/**/hardening-output/last-run.*
spikes/**/hardening-output/*.raw.jsonl
spikes/**/hardening-output/latest-summary.json
